DB_NAME=user_service_db
DB_USERNAME=postgres
DB_PASSWORD=your_password

DB_URL=jdbc:postgresql://postgres:5432/user_service_db
DB_URL_DOCKER=jdbc:postgresql://postgres:5432/user_service_db

REDIS_HOST=localhost
REDIS_PORT=6379

# Auth Service database (separate from User Service)
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=replace_with_another_local_password

# Must be identical in both services
JWT_ISSUER=https://auth.example.com
INTERNAL_API_KEY=replace_with_a_long_random_secret

# Local development bootstrap administrator
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_at_least_12_characters
BOOTSTRAP_ADMIN_USER_ID=900000000
