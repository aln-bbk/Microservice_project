AUTH_DB_URL=jdbc:postgresql://127.0.0.1:5432/auth_service
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=yor_password

JWT_PRIVATE_KEY_PATH=your_private.pem
JWT_PUBLIC_KEY_PATH=your_public.pem

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_at_least_12_characters
BOOTSTRAP_ADMIN_USER_ID=900000000

INTERNAL_API_KEY=your_key

JWT_ISSUER=https://auth.example.com