# User Service database
DB_NAME=user_service_db
DB_USERNAME=postgres
DB_PASSWORD=your_local_password

# Authentication Service database
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=your_local_password

# Order Service database
ORDER_DB_NAME=order_service
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=your_local_password

# JWT
JWT_ISSUER=https://auth.example.com

# Internal communication
INTERNAL_API_KEY=your_local_internal_key

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Bootstrap admin
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
BOOTSTRAP_ADMIN_USER_ID=CHANGE_ME_TO_A_VALID_USER_ID